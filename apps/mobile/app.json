{
  "expo": {
    "name": "Moed",
    "slug": "moed",
    "scheme": "moed",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dynaptics.moed"
    },
    "android": {
      "package": "com.dynaptics.moed",
      "adaptiveIcon": {
        "backgroundColor": "#F5F2ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/moed-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F2ED",
          "dark": {
            "image": "./assets/brand/moed-mark.png",
            "backgroundColor": "#141F1B"
          }
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": { "light": "#24443C", "dark": "#84B5A2" },
              "textColorPrimary": { "light": "#1E2B26", "dark": "#EDE9E1" },
              "windowBackground": { "light": "#FFFDFA", "dark": "#1C2A25" }
            },
            "timePicker": {
              "background": { "light": "#FFFDFA", "dark": "#1C2A25" },
              "headerBackground": { "light": "#24443C", "dark": "#2C5548" },
              "numbersBackgroundColor": { "light": "#E4EAE6", "dark": "#22352E" },
              "numbersSelectorColor": { "light": "#24443C", "dark": "#84B5A2" },
              "numbersTextColor": { "light": "#1E2B26", "dark": "#EDE9E1" }
            }
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#24443C"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Moed reads one calendar so appointments spend your day without being typed twice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
